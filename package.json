{
  "name": "textlens",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time screen translation overlay (English to Thai) for Windows",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm run build:node && npm run build:renderer",
    "build:node": "tsc -p tsconfig.json",
    "build:renderer": "vite build",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "electron": "^43.4.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "zod": "^4.4.3"
  }
}
