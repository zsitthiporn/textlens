# Textlens — environment variables
#
# คัดลอกเป็น .env แล้วแก้ค่า:  cp .env.example .env
# .env ถูก ignore ไว้แล้ว อย่า commit
#
# แต่ละตัวแปรด้านล่างระบุสถานะ implement ไว้ต่อตัว — ไม่ใช่ทุกตัวในไฟล์นี้อยู่สถานะเดียวกัน
#   ค่าที่ผู้ใช้ทั่วไปต้องตั้ง จะย้ายไปอยู่ใน Settings UI ส่วน .env ไว้สำหรับงาน dev

# ─── Logging (implement แล้ว — logger.ts) ────────────────────
# debug | info | warn | error
# debug จะ log ข้อความที่ OCR อ่านได้ด้วย — อย่าใช้กับหน้าจอที่มีข้อมูลส่วนตัว
LOG_LEVEL=info

# ─── Sidecar (dev, implement แล้ว — sidecar-client.ts) ────────
# ชี้ไปที่ build output ของ .NET sidecar แทนตัวที่แนบมากับ package
# ว่างไว้ = ใช้ตัวที่อยู่ข้างๆ แอป
TEXTLENS_SIDECAR_PATH=

# ─── Translation engines ────────────────────────────────────
# Google: default ใช้ endpoint ฟรีที่ไม่ต้องมี key และเป็น engine เดียวที่ implement แล้วตอนนี้
# ไม่มีตัวแปรให้ตั้งสำหรับ Google — ไม่มี paid tier ให้สลับไปใช้ (#48 ตัดทางนั้นถาวรแล้ว)

# LM Studio / Ollama — ยังไม่ implement (T4) ทั้งคู่พูด OpenAI-compatible API
# LM Studio:  http://localhost:1234/v1
# Ollama:     http://localhost:11434/v1
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# DeepL — ยังไม่ implement (P2)
DEEPL_API_KEY=
