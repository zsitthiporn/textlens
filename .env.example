# Textlens — environment variables
#
# คัดลอกเป็น .env แล้วแก้ค่า:  cp .env.example .env
# .env ถูก ignore ไว้แล้ว อย่า commit
#
# ⚠ ตัวแปรด้านล่างเป็นสิ่งที่ออกแบบไว้ ยังไม่ได้ implement (repo ยังไม่มีโค้ด)
#   ค่าที่ผู้ใช้ทั่วไปต้องตั้ง จะย้ายไปอยู่ใน Settings UI ส่วน .env ไว้สำหรับงาน dev

# ─── Logging ────────────────────────────────────────────────
# debug | info | warn | error
# debug จะ log ข้อความที่ OCR อ่านได้ด้วย — อย่าใช้กับหน้าจอที่มีข้อมูลส่วนตัว
LOG_LEVEL=info

# ─── Sidecar (dev) ──────────────────────────────────────────
# ชี้ไปที่ build output ของ .NET sidecar แทนตัวที่แนบมากับ package
# ว่างไว้ = ใช้ตัวที่อยู่ข้างๆ แอป
TEXTLENS_SIDECAR_PATH=

# ─── Translation engines ────────────────────────────────────
# Google: default ใช้ endpoint ฟรีที่ไม่ต้องมี key
# ใส่ key ต่อเมื่อโดน rate limit ที่ cadence ของ subtitle (ดูความเสี่ยง S3 ใน design doc)
GOOGLE_TRANSLATE_API_KEY=

# LM Studio / Ollama — ทั้งคู่พูด OpenAI-compatible API
# LM Studio:  http://localhost:1234/v1
# Ollama:     http://localhost:11434/v1
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# DeepL (P2 ยังไม่ทำ)
DEEPL_API_KEY=
